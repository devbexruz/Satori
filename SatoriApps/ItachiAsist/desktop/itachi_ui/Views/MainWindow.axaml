<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ItachiUI.Controls;assembly=ItachiUI"
        x:Class="ItachiUI.Views.MainWindow"

        Title="ItachiAssist"
        Width="200" Height="200"

        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent"

        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"

        CanResize="False"
        SystemDecorations="None">

    <Window.Styles>
        <!-- Chat bubble stil -->
        <Style Selector="Border.chatBubble">
            <Setter Property="Background" Value="#DD0D0D14"/>
            <Setter Property="CornerRadius" Value="14,14,14,2"/>
            <Setter Property="BorderBrush" Value="#66FF2200"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MaxWidth" Value="280"/>
        </Style>

        <!-- Typing dots -->
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Fill" Value="#FFCC3300"/>
        </Style>

        <!-- Slider stil -->
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="#FFFF2200"/>
        </Style>
    </Window.Styles>

    <!-- Asosiy konteyner — shaffof overlay -->
    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom">

        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Spacing="8"
                    Margin="0,0,14,16">

            <!-- ─── Chat Maydoni ─────────────────────────────── -->
            <Border x:Name="ChatPanel"
                    Classes="chatBubble"
                    IsVisible="False"
                    Margin="0,0,8,4"
                    MaxHeight="200">

                <StackPanel Spacing="8">
                    <!-- Thinking dots animatsiyasi -->
                    <StackPanel x:Name="ThinkingPanel"
                                Orientation="Horizontal"
                                Spacing="5"
                                HorizontalAlignment="Left"
                                IsVisible="False">
                        <Ellipse Classes="dot"/>
                        <Ellipse Classes="dot"/>
                        <Ellipse Classes="dot"/>
                    </StackPanel>

                    <!-- Javob matni -->
                    <TextBlock x:Name="ChatText"
                               Foreground="#EEEEFF"
                               FontFamily="Consolas, Cascadia Code, Monospace"
                               FontSize="13"
                               LineHeight="20"
                               TextWrapping="Wrap"
                               MaxWidth="260"
                               IsVisible="False"/>
                </StackPanel>
            </Border>

            <!-- ─── Input & Boshqaruv Maydoni ────────────────── -->
            <Border x:Name="InputPanel"
                    Background="#CC0A0A12"
                    CornerRadius="14"
                    BorderBrush="#44FF2200"
                    BorderThickness="1.5"
                    Padding="12,10"
                    Width="310"
                    IsVisible="False">

                <StackPanel Spacing="8">
                    <!-- Oynani ko'chirish dastagi (Drag Handle) -->
                    <Border Background="#44FFFFFF" Height="4" Width="48" CornerRadius="2"
                            HorizontalAlignment="Center" Cursor="SizeAll"
                            Margin="0,0,0,2"
                            ToolTip.Tip="Ushlab boshqa joyga ko'chirish"
                            PointerPressed="DragHandle_PointerPressed"/>

                    <!-- Matn kiritish qatori -->
                    <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                        <TextBox x:Name="InputBox"
                                 Grid.Column="0"
                                 Background="Transparent"
                                 Foreground="#DDDDFF"
                                 CaretBrush="#FF4400"
                                 BorderThickness="0"
                                 FontFamily="Consolas, Cascadia Code, Monospace"
                                 FontSize="13"
                                 Watermark="Itachiga so'rov yozing..."
                                 Padding="4,6"
                                 VerticalAlignment="Center"
                                 KeyDown="InputBox_KeyDown"/>

                        <!-- Mikrofon tugmasi -->
                        <Button x:Name="MicBtn"
                                Grid.Column="1"
                                Background="Transparent"
                                Foreground="#FF4422"
                                FontSize="15"
                                Padding="6,4"
                                ToolTip.Tip="Ovoz bilan gapirish"
                                Click="MicBtn_Click">🎙</Button>

                        <!-- Ekran tugmasi -->
                        <Button x:Name="ScreenBtn"
                                Grid.Column="2"
                                Background="Transparent"
                                Foreground="#FF5522"
                                FontSize="16"
                                Padding="6,4"
                                ToolTip.Tip="Ekranga qara"
                                Click="ScreenBtn_Click">👁</Button>

                        <!-- Yuborish tugmasi -->
                        <Button x:Name="SendBtn"
                                Grid.Column="3"
                                Background="#55200A"
                                Foreground="#FF7733"
                                FontSize="14"
                                FontWeight="Bold"
                                Padding="8,4"
                                CornerRadius="8"
                                Click="SendBtn_Click">▶</Button>
                    </Grid>

                    <!-- Ko'zlar Saffoligi (0 - 100%) slayderi -->
                    <Border Background="#22000000" CornerRadius="8" Padding="8,6">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0"
                                           Text="Ko'zlar Saffoligi (Yonish):"
                                           FontSize="11"
                                           Foreground="#AA9999"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="OpacityLabel"
                                           Grid.Column="1"
                                           Text="50% (Auto)"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#FFFF3300"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto">
                                <Slider x:Name="EyeOpacitySlider"
                                        Grid.Column="0"
                                        Minimum="0" Maximum="100"
                                        Value="50"
                                        ValueChanged="EyeOpacitySlider_ValueChanged"/>
                                <Button x:Name="AutoBtn"
                                        Grid.Column="1"
                                        Content="Auto"
                                        FontSize="10"
                                        Background="#333333"
                                        Foreground="#AAAAAA"
                                        Padding="6,2"
                                        Margin="6,0,0,0"
                                        CornerRadius="4"
                                        Click="AutoBtn_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ─── Itachi Avatari (Itachi + Sharingan Ko'zlar) ───── -->
            <local:ItachiAvatarControl x:Name="ItachiAvatar"
                                       Width="180" Height="180"
                                       HorizontalAlignment="Right"
                                       Cursor="Hand"
                                       PointerPressed="Avatar_PointerPressed"
                                       PointerMoved="Avatar_PointerMoved"
                                       PointerReleased="Avatar_PointerReleased"/>

        </StackPanel>
    </Grid>

</Window>
