# ItachiAssist Backend — Muhit O'zgaruvchilari
# =============================================
# Bu faylni .env ga nusxalab to'ldiring:
#   cp .env.example .env

# === Server ===
HOST=127.0.0.1
PORT=8765

# === PostgreSQL ===
# SatoriBackend (ASP.NET Core) bilan birgalikda yoki alohida DB
DATABASE_URL=postgresql+asyncpg://satori:satori@localhost:5432/satoridb

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === AI API Kalitlar ===
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (fallback uchun, ixtiyoriy)
OPENAI_API_KEY=

# === AI Model Sozlamalari ===
LLM_FAST_MODEL=gemini-2.0-flash-lite
LLM_DEEP_MODEL=gemini-2.5-pro
LLM_FAST_MAX_TOKENS=150
LLM_CONTEXT_WINDOW_MINUTES=30

# === Satori Core Backend ===
SATORI_BACKEND_URL=http://localhost:8080
