# SatoriAi configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database URL (SQLite fallback will trigger if Postgres is down)
DATABASE_URL=postgresql://satori_user:admin1234@localhost:5434/satori

# JWT secret and settings matching SatoriBackend
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ISSUER=SatoriApi
JWT_AUDIENCE=SatoriUsers

# SatoriDocs microservice integration URL
SATORIDOCS_URL=http://localhost:8000/api/v1
